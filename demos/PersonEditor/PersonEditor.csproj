<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>13</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PersonDemo</RootNamespace>
    <AssemblyName>PersonEditor</AssemblyName>
    <StartupObject>PersonDemo.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fluorine.Generators\Fluorine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Fluorine\Fluorine.csproj" />
    <ProjectReference Include="..\..\src\Fluorine.Wpf\Fluorine.Wpf.csproj" />
    <ProjectReference Include="..\..\src\Fluorine.WinForms\Fluorine.WinForms.csproj" />
  </ItemGroup>
</Project>
