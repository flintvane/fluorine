<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <!-- Partial properties are C# 13. The generator fills those in. -->
    <LangVersion>13</LangVersion>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Fluorine.GeneratorTests</RootNamespace>
    <AssemblyName>Fluorine.GeneratorTests</AssemblyName>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Roslyn 4.14 needs Immutable 9; .NET 8 ships 8. -->
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fluorine\Fluorine.csproj" />
    <ProjectReference Include="..\..\src\Fluorine.Wpf\Fluorine.Wpf.csproj" />
    <ProjectReference Include="..\..\src\Fluorine.WinForms\Fluorine.WinForms.csproj" />
    <ProjectReference Include="..\..\src\Fluorine.Generators\Fluorine.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>
</Project>
